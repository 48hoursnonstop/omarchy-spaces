#!/usr/bin/env bash
# Tells the Spaces bar widget what a Claude Code session is doing.
# Usage (from Claude Code hooks): claude-hook <working|waiting|done|end>

state="$1"
session=$(jq -r '.session_id // empty' 2>/dev/null)
[[ -n $session ]] || session="pid$PPID"

# The agent's ancestor PIDs. The widget matches them to a terminal window.
pids=""
pid=$PPID
while [[ $pid -gt 1 && -r /proc/$pid/stat ]]; do
  pids+="${pids:+,}$pid"
  stat=$(</proc/$pid/stat)
  stat=${stat##*) }
  pid=$(cut -d' ' -f2 <<<"$stat")
done

omarchy-shell tornikegomareli.spaces agent "$session" "$state" "$pids" >/dev/null 2>&1 &
exit 0
